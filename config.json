{
    "id": "giftcardswasm",
    "name": "Gift Cards",
    "short_description": "Create and redeem Lightning gift cards with LNURL-withdraw",
    "description_md": "https://raw.githubusercontent.com/bitkarrot/giftcardswasm/v0.2.0/description.md",
    "images": [
        {
            "uri": "https://github.com/bitkarrot/giftcardswasm/raw/main/screenshots/06-card-detail-qr.png"
        }
    ],
    "contributors": [
        {
            "name": "bitkarrot",
            "uri": "https://github.com/bitkarrot",
            "role": "Author"
        }
    ],
    "license": "MIT",
    "version": "0.2.0",
    "min_lnbits_version": "1.6.0rc3",
    "tile": "/ext-assets/giftcardswasm/assets/icon.png",
    "tags": ["gift-cards", "lnurl-withdraw", "wasm", "lightning"],
    "extension_type": "wasm",
    "wasm": {
        "module": "wasm/module.wasm",
        "wit": "wasm/wit/world.wit",
        "world": "giftcards",
        "exports": [
            {"name": "create-card", "visibility": "authenticated"},
            {"name": "get-cards", "visibility": "authenticated"},
            {"name": "get-card", "visibility": "authenticated"},
            {"name": "update-card", "visibility": "authenticated"},
            {"name": "delete-card", "visibility": "authenticated"},
            {"name": "bulk-create", "visibility": "authenticated"},
            {"name": "get-wallets", "visibility": "authenticated"},
            {"name": "get-settings", "visibility": "authenticated"},
            {"name": "set-settings", "visibility": "authenticated"},
            {"name": "get-public-card", "visibility": "public"},
            {"name": "lnurl-params", "visibility": "public"},
            {"name": "lnurl-callback", "visibility": "public"},
            {"name": "on-invoice-paid", "visibility": "event"}
        ]
    },
    "ui_routes": [
        {
            "path": "/giftcardswasm",
            "entrypoint": "templates/index.html",
            "auth": "user"
        },
        {
            "path": "/giftcardswasm/redeem/{token}",
            "entrypoint": "templates/redeem.html",
            "auth": "public"
        }
    ],
    "api_routes": [
        {
            "method": "POST",
            "path": "/cards",
            "export": "create-card",
            "auth": "user"
        },
        {
            "method": "GET",
            "path": "/cards",
            "export": "get-cards",
            "auth": "user"
        },
        {
            "method": "GET",
            "path": "/cards/{cardId}",
            "export": "get-card",
            "auth": "user"
        },
        {
            "method": "PUT",
            "path": "/cards/{cardId}",
            "export": "update-card",
            "auth": "user"
        },
        {
            "method": "POST",
            "path": "/cards/bulk",
            "export": "bulk-create",
            "auth": "user"
        },
        {
            "method": "GET",
            "path": "/wallets",
            "export": "get-wallets",
            "auth": "user"
        },
        {
            "method": "GET",
            "path": "/settings",
            "export": "get-settings",
            "auth": "user"
        },
        {
            "method": "PUT",
            "path": "/settings",
            "export": "set-settings",
            "auth": "user"
        },
        {
            "method": "DELETE",
            "path": "/cards/{cardId}",
            "export": "delete-card",
            "auth": "user"
        },
        {
            "method": "GET",
            "path": "/cards/public/{tokenHash}",
            "export": "get-public-card",
            "auth": "public",
            "ownerContext": {"table": "cards", "idParam": "tokenHash"}
        },
        {
            "method": "GET",
            "path": "/lnurl/callback",
            "export": "lnurl-callback",
            "auth": "public",
            "ownerContext": {"table": "cards", "idParam": "k1"}
        },
        {
            "method": "GET",
            "path": "/lnurl/{tokenHash}",
            "export": "lnurl-params",
            "auth": "public",
            "ownerContext": {"table": "cards", "idParam": "tokenHash"}
        }
    ],
    "events": {
        "onInvoicePaid": "on-invoice-paid"
    },
    "permissions": [
        {"id": "ext.storage.read", "description": "Read gift card storage"},
        {"id": "ext.storage.read_public", "description": "Read public gift card data", "policies": [{"table_name": "cards", "public_fields": ["amount", "status", "recipientName", "senderName", "message", "createdAt", "expiresAt", "redeemedAt", "expiredAt", "designJson", "templateName", "templateAssetId", "qrConfig", "textConfig"], "source_id_field": "id"}]},
        {"id": "ext.storage.write", "description": "Write gift card storage"},
        {"id": "wallet.pay_invoice", "description": "Pay invoices (redeem gift cards)"},
        {"id": "wallet.pay_invoice_background", "description": "Pay invoices in background"},
        {"id": "wallet.list", "description": "List user wallets"}
    ]
}
